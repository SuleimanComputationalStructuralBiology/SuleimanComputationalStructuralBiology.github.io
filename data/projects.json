    "id": "stn7-stn8",
    "title": "STN7 / STN8 Chloroplast Kinases",
    "subtitle": "Comparative structural, evolutionary & complex modelling of thylakoid kinases",
    "organism": "Arabidopsis thaliana (+ rice, maize, Chlamydomonas)",
    "targets": [
      {
        "name": "STN7",
        "uniprot": "Q9S713"
      },
      {
        "name": "STN8",
        "uniprot": "Q9LZV4"
      }
    ],
    "status": "Manuscript in preparation",
    "tags": [
      "AlphaFold DB v6",
      "AF2-multimer v3",
      "Kabsch/SVD RMSD",
      "MSA",
      "Shannon entropy",
      "NJ phylogeny",
      "Kyte–Doolittle",
      "AutoDock Vina"
    ],
    "summary": "STN7 drives PSII↔PSI state transitions through LHCII phosphorylation, while STN8 phosphorylates PSII core proteins during high-light repair. This pipeline retrieves AlphaFold models and orthologs across dicots, monocots and green algae, performs MSA, phylogeny, SVD superposition, domain-level confidence statistics, hydropathy profiling, motif annotation and models the STN7–STN8 heterodimer with AlphaFold2-multimer; ligand libraries are prepared for docking.",
    "pipeline": [
      "UniProt / AlphaFold DB retrieval",
      "Ortholog MSA & NJ phylogeny",
      "SVD superposition & RMSD",
      "Domain pLDDT statistics",
      "AF2-multimer heterodimer",
      "Receptor/ligand prep → AutoDock Vina"
    ],
    "metrics": [
      {
        "label": "STN7 kinase pLDDT",
        "value": 84.5
      },
      {
        "label": "STN8 kinase pLDDT",
        "value": 85.5
      },
      {
        "label": "Kinase RMSD",
